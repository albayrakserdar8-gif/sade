# Otari gateway (https://otari.ai). Create a key in the dashboard under API keys.
OTARI_API_BASE=https://otari.ai
OTARI_API_KEY=otk_...
# Path segment that guards the endpoints Otari calls back (MCP, guardrail).
SADE_PUBLIC_SECRET=change-me
# One Otari key per demo user, each with its own budget (dashboard: API keys -> Budget).
OTARI_KEY_AYSE=
OTARI_KEY_ZEYNEP=
OTARI_KEY_MEHMET=
